# Active provider: openai | groq | nvidia | sarvam | anthropic | openrouter
LLM_PROVIDER=nvidia

# Optional overrides (defaults come from src/mastra/config/model-providers.ts)
# LLM_AGENT_MODEL=nvidia/meta/llama-3.3-70b-instruct
# LLM_MEMORY_MODEL=nvidia/meta/llama-3.1-8b-instruct
# LLM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Copy this file to `.env` (or `.env.local`), then fill in real keys.
# `.env.example` is a template only — Mastra does NOT load it at runtime.
#
# Chat uses LLM_PROVIDER. Memory embeddings need ONE of:
#   OPENAI_API_KEY (openai/text-embedding-3-small)  OR
#   GOOGLE_API_KEY                                 OR
#   NVIDIA_API_KEY (falls back to NVIDIA NIM embeddings)
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
